# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud → App settings → Secrets.
# Use a separate OpenRouter key with a spending limit: the public demo spends from it.
OPENROUTER_API_KEY = "sk-or-..."
# Optional: links to the knowledge base files on GitHub next to each source
REPO_URL = "https://github.com/<user>/echo-assistant/blob/main"
